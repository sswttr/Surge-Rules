#!name=VVebo Profile Fix V3
#!desc=VVebo 旧版主页兼容实验：users/show 精简 + user_timeline 改写到新版 profile/container_timeline + 转回 statuses
#!system=ios

[Script]
VVebo V3 Request = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/(users\/show|statuses\/user_timeline)(?:\?|$),requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/sswttr/Surge-Rules/refs/heads/main/vvebo_v3_request.js
VVebo V3 Response = type=http-response,pattern=^https:\/\/api\.weibo\.cn\/2\/(users\/show|profile\/container_timeline)(?:\?|$),requires-body=1,max-size=5242880,script-path=https://raw.githubusercontent.com/sswttr/Surge-Rules/refs/heads/main/vvebo_v3_response.js

[MITM]
hostname = %APPEND% api.weibo.cn
