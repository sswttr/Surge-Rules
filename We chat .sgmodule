#!name=WeChat Direct
#!desc=微信流量排除出 TUN，避免 mmtls 被 HTTP 引擎处理导致微信运动等加载慢
#!category=Network

[General]
# 微信/腾讯 IP 段不进入 Surge 虚拟网卡
tun-excluded-routes = %APPEND% 183.47.0.0/16, 183.60.0.0/16, 183.3.0.0/16, 183.232.0.0/16, 120.232.0.0/16, 58.251.0.0/16, 14.17.0.0/16, 14.18.0.0/16, 109.244.0.0/16
# 微信相关域名使用真实 IP
always-real-ip = %APPEND% *.weixin.qq.com, *.wechat.com, *.qpic.cn, *.qlogo.cn
# 优先使用国内 DNS
dns-server = %INSERT% 223.5.5.5, 119.29.29.29

[Rule]
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT
DOMAIN-SUFFIX,qq.com,DIRECT
DOMAIN-SUFFIX,qpic.cn,DIRECT
DOMAIN-SUFFIX,qlogo.cn,DIRECT
IP-CIDR,183.47.0.0/16,DIRECT,no-resolve
IP-CIDR,183.60.0.0/16,DIRECT,no-resolve
IP-CIDR,183.3.0.0/16,DIRECT,no-resolve

[MITM]
# 排除微信域名，不做 HTTPS 解密
hostname = %INSERT% -*.weixin.qq.com, -*.wechat.com, -*.qq.com