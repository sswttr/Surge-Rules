#!name=VVebo User Timeline Fix V2
#!desc=修复旧版 VVebo 用户主页 user_timeline 请求缺少 uid 的问题

[Script]
VVebo Save UID & Fix Timeline = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/(users\/show|statuses\/user_timeline),requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/sswttr/Surge-Rules/refs/heads/main/vvebo_request.js

[MITM]
hostname = %APPEND% api.weibo.cn
